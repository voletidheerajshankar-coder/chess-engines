"""
UltimateHybridEngine
--------------------
Layers:
  1. RubyPiece           - object model wrapping a chess piece
  2. AlphaZeroEvaluator  - positional evaluation (material + piece-square tables)
  3. UltimateHybridEngine- move ordering + alpha-beta search
  4. 3-tier move selection: Stockfish -> internal search -> random legal move

Requires:  pip install chess
Optional:  a Stockfish binary on PATH (or pass stockfish_path=...)
"""

import random
import shutil
import time

import chess
import chess.engine


# ---------------------------------------------------------------------------
# 1. Object model
# ---------------------------------------------------------------------------
class RubyPiece:
    """Encapsulates a piece's type and color."""

    def __init__(self, piece_type: int, color: bool):
        self.piece_type = piece_type
        self.color = color

    @classmethod
    def from_square(cls, board: chess.Board, square: int):
        p = board.piece_at(square)
        return cls(p.piece_type, p.color) if p else None

    @property
    def symbol(self) -> str:
        """Uppercase for White, lowercase for Black."""
        s = chess.piece_symbol(self.piece_type)
        return s.upper() if self.color == chess.WHITE else s.lower()

    def __repr__(self):
        return f"RubyPiece({self.symbol})"


# ---------------------------------------------------------------------------
# 2. Evaluator (hand-crafted positional heuristics, not a trained network)
# ---------------------------------------------------------------------------
class AlphaZeroEvaluator:
    MATERIAL = {
        chess.PAWN: 100, chess.KNIGHT: 320, chess.BISHOP: 330,
        chess.ROOK: 500, chess.QUEEN: 900, chess.KING: 0,
    }

    # Tables written from White's view, rank 8 at the top (row 0 = rank 8).
    PST = {
        chess.PAWN: [
            0, 0, 0, 0, 0, 0, 0, 0,
            50, 50, 50, 50, 50, 50, 50, 50,
            10, 10, 20, 30, 30, 20, 10, 10,
            5, 5, 10, 25, 25, 10, 5, 5,
            0, 0, 0, 20, 20, 0, 0, 0,
            5, -5, -10, 0, 0, -10, -5, 5,
            5, 10, 10, -20, -20, 10, 10, 5,
            0, 0, 0, 0, 0, 0, 0, 0,
        ],
        chess.KNIGHT: [
            -50, -40, -30, -30, -30, -30, -40, -50,
            -40, -20, 0, 0, 0, 0, -20, -40,
            -30, 0, 10, 15, 15, 10, 0, -30,
            -30, 5, 15, 20, 20, 15, 5, -30,
            -30, 0, 15, 20, 20, 15, 0, -30,
            -30, 5, 10, 15, 15, 10, 5, -30,
            -40, -20, 0, 5, 5, 0, -20, -40,
            -50, -40, -30, -30, -30, -30, -40, -50,
        ],
        chess.BISHOP: [
            -20, -10, -10, -10, -10, -10, -10, -20,
            -10, 0, 0, 0, 0, 0, 0, -10,
            -10, 0, 5, 10, 10, 5, 0, -10,
            -10, 5, 5, 10, 10, 5, 5, -10,
            -10, 0, 10, 10, 10, 10, 0, -10,
            -10, 10, 10, 10, 10, 10, 10, -10,
            -10, 5, 0, 0, 0, 0, 5, -10,
            -20, -10, -10, -10, -10, -10, -10, -20,
        ],
        chess.ROOK: [
            0, 0, 0, 0, 0, 0, 0, 0,
            5, 10, 10, 10, 10, 10, 10, 5,
            -5, 0, 0, 0, 0, 0, 0, -5,
            -5, 0, 0, 0, 0, 0, 0, -5,
            -5, 0, 0, 0, 0, 0, 0, -5,
            -5, 0, 0, 0, 0, 0, 0, -5,
            -5, 0, 0, 0, 0, 0, 0, -5,
            0, 0, 0, 5, 5, 0, 0, 0,
        ],
        chess.QUEEN: [
            -20, -10, -10, -5, -5, -10, -10, -20,
            -10, 0, 0, 0, 0, 0, 0, -10,
            -10, 0, 5, 5, 5, 5, 0, -10,
            -5, 0, 5, 5, 5, 5, 0, -5,
            0, 0, 5, 5, 5, 5, 0, -5,
            -10, 5, 5, 5, 5, 5, 0, -10,
            -10, 0, 5, 0, 0, 0, 0, -10,
            -20, -10, -10, -5, -5, -10, -10, -20,
        ],
        # King safety: stay tucked away on the back rank, avoid the open center.
        chess.KING: [
            -30, -40, -40, -50, -50, -40, -40, -30,
            -30, -40, -40, -50, -50, -40, -40, -30,
            -30, -40, -40, -50, -50, -40, -40, -30,
            -30, -40, -40, -50, -50, -40, -40, -30,
            -20, -30, -30, -40, -40, -30, -30, -20,
            -10, -20, -20, -20, -20, -20, -20, -10,
            20, 20, 0, 0, 0, 0, 20, 20,
            20, 30, 10, 0, 0, 10, 30, 20,
        ],
    }

    def _pst(self, piece: RubyPiece, square: int) -> int:
        # python-chess: a1 = 0. Tables have rank 8 first, so flip for White.
        idx = square ^ 56 if piece.color == chess.WHITE else square
        return self.PST[piece.piece_type][idx]

    def evaluate(self, board: chess.Board) -> int:
        """Score in centipawns from the side-to-move's perspective."""
        if board.is_checkmate():
            return -100_000
        if (board.is_stalemate() or board.is_insufficient_material()
                or board.can_claim_draw()):
            return 0

        score = 0
        for square, p in board.piece_map().items():
            piece = RubyPiece(p.piece_type, p.color)
            value = self.MATERIAL[piece.piece_type] + self._pst(piece, square)
            score += value if piece.color == chess.WHITE else -value
        return score if board.turn == chess.WHITE else -score


# ---------------------------------------------------------------------------
# 3. Engine
# ---------------------------------------------------------------------------
class UltimateHybridEngine:
    MATE = 100_000

    def __init__(self, depth: int = 3, stockfish_path: str | None = None,
                 stockfish_time: float = 0.5):
        self.depth = depth
        self.stockfish_time = stockfish_time
        self.evaluator = AlphaZeroEvaluator()
        self.nodes = 0

        self.stockfish_path = stockfish_path or shutil.which("stockfish")
        self._sf = None

    # ---- Move ordering ("policy surrogate") -----------------------------
    def _move_score(self, board: chess.Board, move: chess.Move) -> int:
        score = 0
        if move.promotion:
            score += 900 + self.evaluator.MATERIAL[move.promotion]
        if board.is_capture(move):
            victim = board.piece_at(move.to_square)
            attacker = board.piece_at(move.from_square)
            v = self.evaluator.MATERIAL[victim.piece_type] if victim else 100  # en passant
            a = self.evaluator.MATERIAL[attacker.piece_type]
            score += 10 * v - a  # MVV-LVA
        if board.gives_check(move):
            score += 50
        return score

    def _ordered_moves(self, board: chess.Board):
        return sorted(board.legal_moves,
                      key=lambda m: self._move_score(board, m), reverse=True)

    # ---- Alpha-beta (negamax) -------------------------------------------
    def _negamax(self, board: chess.Board, depth: int, alpha: int, beta: int,
                 ply: int) -> int:
        self.nodes += 1
        if board.is_game_over() or depth == 0:
            if board.is_checkmate():
                return -self.MATE + ply  # prefer faster mates
            return self.evaluator.evaluate(board)

        best = -self.MATE * 2
        for move in self._ordered_moves(board):
            board.push(move)
            val = -self._negamax(board, depth - 1, -beta, -alpha, ply + 1)
            board.pop()
            if val > best:
                best = val
            alpha = max(alpha, val)
            if alpha >= beta:
                break  # prune
        return best

    def _internal_search(self, board: chess.Board) -> chess.Move | None:
        self.nodes = 0
        best_move, best_val = None, -self.MATE * 2
        alpha, beta = -self.MATE * 2, self.MATE * 2
        for move in self._ordered_moves(board):
            board.push(move)
            val = -self._negamax(board, self.depth - 1, -beta, -alpha, 1)
            board.pop()
            if val > best_val:
                best_val, best_move = val, move
            alpha = max(alpha, val)
        return best_move

    # ---- Tier 1: Stockfish ----------------------------------------------
    def _stockfish_move(self, board: chess.Board) -> chess.Move | None:
        if not self.stockfish_path:
            return None
        try:
            if self._sf is None:
                self._sf = chess.engine.SimpleEngine.popen_uci(self.stockfish_path)
            result = self._sf.play(board, chess.engine.Limit(time=self.stockfish_time))
            return result.move
        except Exception:
            self._sf = None
            return None

    # ---- 3-tier selector ------------------------------------------------
    def select_move(self, board: chess.Board) -> chess.Move | None:
        legal = list(board.legal_moves)
        if not legal:
            return None

        # Tier 1
        move = self._stockfish_move(board)
        if move in legal:
            return move

        # Tier 2
        try:
            move = self._internal_search(board)
            if move in legal:
                return move
        except Exception:
            pass

        # Tier 3
        return random.choice(legal)

    def close(self):
        if self._sf is not None:
            try:
                self._sf.quit()
            except Exception:
                pass
            self._sf = None


# ---------------------------------------------------------------------------
# Demo: engine vs. itself (internal search only, no Stockfish, for speed)
# ---------------------------------------------------------------------------
if __name__ == "__main__":
    engine = UltimateHybridEngine(depth=3, stockfish_path=None)
    board = chess.Board()
    start = time.time()

    while not board.is_game_over() and board.fullmove_number <= 40:
        move = engine.select_move(board)
        print(f"{board.fullmove_number}{'.' if board.turn else '...'} "
              f"{board.san(move)}  (nodes: {engine.nodes})")
        board.push(move)

    print(board)
    print("Result:", board.result(claim_draw=True), f"| {time.time() - start:.1f}s")
    engine.close()
